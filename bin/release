
#!/bin/sh
# bin/release <build-dir>

set -eu

### Configure directories
BUILD_DIR="${1:-}"

if [ -z "$BUILD_DIR" ] || [ ! -d "$BUILD_DIR" ]; then
    echo "ERROR: Usage: bin/release <build-dir>" >&2
    exit 1
fi

export BUILD_DIR

### Load runtime environment
PROFILE_FILE="$BUILD_DIR/.profile.d/dotnetcore.sh"

if [ -f "$PROFILE_FILE" ]; then
    . "$PROFILE_FILE"
fi

### Read application configuration
APP_ASSEMBLY="${APP_ASSEMBLY:-}"
RELEASE_DIR="${RELEASE_DIR:-}"

if [ -z "$APP_ASSEMBLY" ]; then
    echo "ERROR: APP_ASSEMBLY is not defined in dotnetcore.sh." >&2
    exit 1
fi

if [ -z "$RELEASE_DIR" ]; then
    echo "ERROR: RELEASE_DIR is not defined in dotnetcore.sh." >&2
    exit 1
fi

### Generate release metadata
printf '%s\n' '---' 'config_vars:'

if [ ! -f "$BUILD_DIR/Procfile" ]; then
    printf '%s\n' 'default_process_types:'
    printf '  web: cd "$HOME/%s" && dotnet "./%s.dll" --urls "http://+:$PORT"\n' \
        "$RELEASE_DIR" "$APP_ASSEMBLY"
fi
