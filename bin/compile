
#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

set -o errexit
set -o pipefail
set -o nounset
unset GIT_DIR

### Configure directories
BUILD_DIR="${1:-}"
CACHE_DIR="${2:-}"
ENV_DIR="${3:-}"
BP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -z "$BUILD_DIR" || -z "$CACHE_DIR" || -z "$ENV_DIR" ]]; then
    echo "Usage: $0 <build-dir> <cache-dir> <env-dir>" >&2
    exit 1
fi

### Load dependencies
# shellcheck source=util/common.sh
source "$BP_DIR/bin/util/common.sh"

# shellcheck source=util/awscli-install.sh
source "$BP_DIR/bin/util/awscli-install.sh"

# shellcheck source=util/apt_dpkg_install.sh
source "$BP_DIR/bin/util/apt_dpkg_install.sh"

### Install AWS CLI
if ! awscli_install; then
    echo "ERROR: AWS CLI installation failed." >&2
    exit 1
fi

### Export environment
export_env_dir "$ENV_DIR"

### Verify AWS CLI is available during compilation
if ! command -v aws >/dev/null 2>&1; then
    echo "ERROR: AWS CLI is not available in PATH after installation." >&2
    echo "PATH: $PATH" >&2
    exit 1
fi

echo "AWS CLI path: $(command -v aws)"
aws --version

### Detect Ubuntu version
declare herokuos_version framework_version runtime_framework_version
declare PROJECT_CSPROJ PROJECT_FILE SOLUTION_FILE SOLUTION_NAME
declare APP_ASSEMBLY RELEASE_DIR DOTNET_DIR PROFILE_PATH
declare filename project_dir

herokuos_version="$(get_linux_platform_version)"
print "OS: Ubuntu ${herokuos_version}"
print "Stack version: ${STACK:-unknown}"
print "Installing prerequisites for .NET on Ubuntu"

case "$herokuos_version" in
    "16.04")
        apt_install ca-certificates libc6 libgcc1 libgssapi-krb5-2 libicu55 libssl1.0.0 libstdc++6 zlib1g
        ;;
    "18.04")
        apt_install ca-certificates libc6 libgcc1 libgssapi-krb5-2 libicu60 libssl1.1 libstdc++6 zlib1g
        ;;
    "19.04")
        apt_install ca-certificates libc6 libgcc-s1 libgssapi-krb5-2 libicu63 libssl1.1 libstdc++6 zlib1g
        ;;
    "20.04")
        apt_install apt-transport-https ca-certificates libc6 libgcc-s1 libgssapi-krb5-2 libicu66 libssl1.1 libstdc++6 zlib1g
        ;;
    "22.04")
        apt_install apt-transport-https ca-certificates libc6 libgcc-s1 libgssapi-krb5-2 libicu70 libssl3 libstdc++6 libunwind8 zlib1g
        ;;
    "24.04")
        apt_install ca-certificates libc6 libgcc-s1 libgssapi-krb5-2 libicu74 libssl3 libstdc++6 zlib1g
        ;;
    *)
        print "ERROR: Unsupported Ubuntu version: ${herokuos_version}"
        exit 1
        ;;
esac

### Configure .NET environment
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE="${DOTNET_SKIP_FIRST_TIME_EXPERIENCE:-1}"
export DOTNET_CLI_TELEMETRY_OPTOUT="${DOTNET_CLI_TELEMETRY_OPTOUT:-1}"
export ASPNETCORE_ENVIRONMENT="${ASPNETCORE_ENVIRONMENT:-Production}"

### Locate project
PROJECT_CSPROJ=""
while IFS= read -r -d '' filename; do
    PROJECT_CSPROJ="$filename"
    break
done < <(find "$BUILD_DIR" -maxdepth 2 -type f -name "*.csproj" -print0)

if [[ -z "$PROJECT_CSPROJ" ]]; then
    print "ERROR: No .csproj found within two directory levels of ${BUILD_DIR}"
    exit 1
fi

project_dir="$(dirname "$PROJECT_CSPROJ")"
print "Project directory: ${project_dir}"
print "Project file: ${PROJECT_CSPROJ}"

### Detect SDK version
framework_version="$(get_framework_version "$project_dir")"
runtime_framework_version="$(get_specific_version "$BUILD_DIR")"

if [[ -z "$runtime_framework_version" ]]; then
    runtime_framework_version="$(get_runtime_framework_version "$project_dir")"
fi

if [[ -z "$runtime_framework_version" && -z "$framework_version" ]]; then
    print "ERROR: Unable to determine the .NET SDK channel or version."
    exit 1
fi

print "SDK channel: ${framework_version:-not specified}"
print "SDK version: ${runtime_framework_version:-not specified}"

### Install .NET SDK
DOTNET_DIR="$BUILD_DIR/.dotnet"
mkdir -p "$DOTNET_DIR"

if [[ -n "$runtime_framework_version" && "$runtime_framework_version" != "Latest" ]]; then
    "$BP_DIR/bin/util/dotnet-install.sh" \
        --architecture x64 \
        --version "$runtime_framework_version" \
        --install-dir "$DOTNET_DIR" \
        --no-path
else
    "$BP_DIR/bin/util/dotnet-install.sh" \
        --architecture x64 \
        --channel "$framework_version" \
        --install-dir "$DOTNET_DIR" \
        --no-path
fi

if [[ ! -x "$DOTNET_DIR/dotnet" ]]; then
    print "ERROR: .NET SDK installation failed: $DOTNET_DIR/dotnet"
    exit 1
fi

### Configure .NET for build
export DOTNET_ROOT="$DOTNET_DIR"
export PATH="$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH"

print "Installed .NET SDK information:"
dotnet --info
print "Installed .NET SDKs:"
dotnet --list-sdks
print "Installed .NET runtimes:"
dotnet --list-runtimes

### Configure .NET for runtime
PROFILE_PATH="$BUILD_DIR/.profile.d/dotnetcore.sh"
mkdir -p "$(dirname "$PROFILE_PATH")"

cat > "$PROFILE_PATH" <<'EOF'
#!/usr/bin/env bash
export DOTNET_ROOT="/app/.dotnet"
export PATH="/app/.dotnet:/app/.dotnet/tools:/app/.apt/usr/bin:/app/vendor/awscli/bin:$PATH"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
EOF

chmod +x "$PROFILE_PATH"

### Clear NuGet caches
print "Clearing NuGet caches"
dotnet nuget locals all --clear || true

### Locate solution
SOLUTION_FILE="$(get_project_sln_file "$BUILD_DIR")"

if [[ -z "$SOLUTION_FILE" ]]; then
    ### Publish project
    PROJECT_FILE="$(get_project_file "$BUILD_DIR")"

    if [[ -z "$PROJECT_FILE" ]]; then
        print "ERROR: Could not locate project file."
        exit 1
    fi

    APP_ASSEMBLY="$(get_project_name "$BUILD_DIR")"

    if [[ -z "$APP_ASSEMBLY" ]]; then
        print "ERROR: Could not determine application assembly name."
        exit 1
    fi

    print "Assembly name: ${APP_ASSEMBLY}"
    RELEASE_DIR="${APP_ASSEMBLY}_Release"

    echo "export APP_ASSEMBLY=\"${APP_ASSEMBLY}\"" >> "$PROFILE_PATH"
    echo "export RELEASE_DIR=\"${RELEASE_DIR}\"" >> "$PROFILE_PATH"

    cd "$BUILD_DIR"
    dotnet publish "$PROJECT_FILE" \
        -p:PublishDir="$BUILD_DIR/$RELEASE_DIR" \
        --configuration Release \
        --runtime linux-x64 \
        --no-self-contained
else
    ### Publish solution
    APP_ASSEMBLY="$(get_start_project_name "$BUILD_DIR")"
    SOLUTION_NAME="$(get_project_sln_name "$BUILD_DIR")"

    if [[ -z "$APP_ASSEMBLY" || -z "$SOLUTION_NAME" ]]; then
        print "ERROR: Could not determine startup assembly or solution name."
        exit 1
    fi

    print "Assembly name: ${APP_ASSEMBLY}"
    print "Solution name: ${SOLUTION_NAME}"
    RELEASE_DIR="${SOLUTION_NAME}_Release"

    echo "export APP_ASSEMBLY=\"${APP_ASSEMBLY}\"" >> "$PROFILE_PATH"
    echo "export RELEASE_DIR=\"${RELEASE_DIR}\"" >> "$PROFILE_PATH"

    cd "$BUILD_DIR"
    dotnet publish "$SOLUTION_FILE" \
        -p:PublishDir="$BUILD_DIR/$RELEASE_DIR" \
        --configuration Release \
        --runtime linux-x64 \
        --no-self-contained
fi

### Verify publish output
if [[ ! -d "$BUILD_DIR/$RELEASE_DIR" ]]; then
    print "ERROR: Publish output directory was not created."
    exit 1
fi

if [[ ! -f "$BUILD_DIR/$RELEASE_DIR/$APP_ASSEMBLY.dll" ]]; then
    print "ERROR: Published assembly not found: $BUILD_DIR/$RELEASE_DIR/$APP_ASSEMBLY.dll"
    exit 1
fi

### Remove source files from production directory
cd "$BUILD_DIR"

find . -maxdepth 1 \
    ! -name "." \
    ! -name "Procfile" \
    ! -name ".profile.d" \
    ! -name ".apt" \
    ! -name ".aws" \
    ! -name "vendor" \
    ! -name ".dotnet" \
    ! -name ".heroku" \
    ! -name "node_modules" \
    ! -name "$RELEASE_DIR" \
    -exec rm -rv -- {} \; >/dev/null 2>&1

### Create Procfile if missing
if [[ ! -f "$BUILD_DIR/Procfile" ]]; then
    cat > "$BUILD_DIR/Procfile" <<EOF
web: cd \$HOME/$RELEASE_DIR && dotnet "./$APP_ASSEMBLY.dll" --urls http://+:\$PORT
EOF
fi

print ".NET buildpack compilation completed successfully."
