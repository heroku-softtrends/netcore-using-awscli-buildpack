```bash
#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset

### Configure directories
BUILD_DIR="${1:-}"

if [[ -z "$BUILD_DIR" || ! -d "$BUILD_DIR" ]]; then
    echo "ASP.NET Core buildpack: invalid build directory." >&2
    exit 1
fi

### Detect solution or project
SOLUTION_FILE=""
PROJECT_FILE=""

while IFS= read -r -d '' file; do
    SOLUTION_FILE="$file"
    break
done < <(
    find "$BUILD_DIR" -maxdepth 2 -type f \
        \( -name "*.sln" -o -name "*.slnx" \) -print0
)

if [[ -z "$SOLUTION_FILE" ]]; then
    while IFS= read -r -d '' file; do
        PROJECT_FILE="$file"
        break
    done < <(
        find "$BUILD_DIR" -maxdepth 2 -type f \
            -name "*.csproj" -print0
    )
fi

if [[ -n "$SOLUTION_FILE" || -n "$PROJECT_FILE" ]]; then
    echo "ASP.NET Core"
    exit 0
fi

echo "ASP.NET Core buildpack: no .sln, .slnx, or .csproj found." >&2
exit 1
```